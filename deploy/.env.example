# Copy outside Git, fill in, and pass its absolute path as AAF_ENV_FILE.

# Public addresses. Passkeys are tied to the directory hostname: choose it once.
AAF_DIRECTORY_URL=https://aaf-dir.example.org
AAF_SHOP_URL=https://aaf-shop.example.org
# Which directories the shop trusts, and which counterparties the directory serves.
AAF_TRUSTED_DIRECTORIES=https://aaf-dir.example.org
AAF_TRUSTED_COUNTERPARTIES=https://aaf-shop.example.org
AAF_DIRECTORY_NAME=AAF Pilot Directory
AAF_OPERATOR_EMAIL=operator@example.org
# Behind Cloudflare Tunnel: take the client address from CF-Connecting-IP.
AAF_TRUST_PROXY=1

# Invitation email through Resend (HTTPS; many hosts block the SMTP ports).
# Put the key in a file readable by the service user and name the file here.
AAF_MAIL_FROM=AAF Pilot <pilot@example.org>
AAF_RESEND_KEY_FILE=
# No mail service yet? Uncomment to show each link once to the operator instead.
# Principals enrolled that way are recorded with NO mailbox assurance.
# AAF_INVITE_FALLBACK=operator-link

# Shop administrator sign-in (decision feed, incident reports). Long and random.
AAF_SHOP_ADMIN_TOKEN=
# The decision feed is private unless this is 1. Leave it off for real tests.
AAF_SHOP_PUBLIC_FEED=0
