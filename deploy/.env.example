# Public addresses. Passkeys are tied to the directory hostname: choose it once.
AAF_DIRECTORY_URL=https://aaf-directory.example.org
AAF_SHOP_URL=https://aaf-shop.example.org
AAF_TRUSTED_DIRECTORIES=https://aaf-directory.example.org
AAF_DIRECTORY_NAME=AAF Pilot Directory
AAF_OPERATOR_EMAIL=you@example.org

# Invitation email. One of:
#   smtps://USER:PASSWORD@smtp.example.org:465
#   smtp://USER:PASSWORD@smtp.example.org:587      (STARTTLS)
AAF_SMTP_URL=
AAF_MAIL_FROM=AAF Pilot <pilot@example.org>

# Shop administrator sign-in (report incidents, see the decision feed).
AAF_SHOP_ADMIN_TOKEN=change-me-to-a-long-random-string
# Set to 1 to let anyone with the link watch the shop's decision feed (useful for demos).
AAF_SHOP_PUBLIC_FEED=1

# Only if you use the bundled Cloudflare Tunnel service (--profile tunnel).
CLOUDFLARE_TUNNEL_TOKEN=
